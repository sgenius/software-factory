{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://software-factory.local/schemas/test-result.schema.json",
  "title": "TestResult",
  "description": "Tester's structured pass/fail output for one task's acceptance criteria — the Report turn's output.",
  "type": "object",
  "required": ["taskId", "results", "testsRun"],
  "additionalProperties": false,
  "properties": {
    "taskId": { "type": "string" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["criterionId", "passed"],
        "additionalProperties": false,
        "properties": {
          "criterionId": { "type": "string" },
          "passed": { "type": "boolean" },
          "reason": {
            "type": "string",
            "description": "Required in practice when passed is false — a concrete, actionable reason."
          }
        }
      }
    },
    "testsRun": {
      "type": "array",
      "items": { "type": "string" },
      "description": "File paths or commands used, so the result is reproducible."
    }
  }
}
